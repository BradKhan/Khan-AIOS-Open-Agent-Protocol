{
  "version": 1,
  "tasks": [
    {
      "id": "words-reverse",
      "category": "text",
      "prompt": "Reverse the whitespace-separated words of the string and join them with single spaces.",
      "cases": [
        {
          "input": "one two three",
          "expected": "three two one"
        },
        {
          "input": "hello",
          "expected": "hello"
        },
        {
          "input": "  a   b  ",
          "expected": "b a"
        }
      ]
    },
    {
      "id": "dedupe-stable",
      "category": "data",
      "prompt": "Return a list of unique values in their first-seen order.",
      "cases": [
        {
          "input": [
            2,
            1,
            2,
            3,
            1
          ],
          "expected": [
            2,
            1,
            3
          ]
        },
        {
          "input": [],
          "expected": []
        },
        {
          "input": [
            "a",
            "b",
            "a"
          ],
          "expected": [
            "a",
            "b"
          ]
        }
      ]
    },
    {
      "id": "sum-positive",
      "category": "data",
      "prompt": "Sum only positive integer values from the input list.",
      "cases": [
        {
          "input": [
            1,
            -2,
            3,
            0
          ],
          "expected": 4
        },
        {
          "input": [],
          "expected": 0
        },
        {
          "input": [
            -1,
            -3
          ],
          "expected": 0
        }
      ]
    },
    {
      "id": "normalize-email",
      "category": "text",
      "prompt": "Strip surrounding whitespace and lowercase the address.",
      "cases": [
        {
          "input": "  Alice@EXAMPLE.com ",
          "expected": "alice@example.com"
        },
        {
          "input": "a@b.io",
          "expected": "a@b.io"
        },
        {
          "input": "TEST@MAIL.ORG",
          "expected": "test@mail.org"
        }
      ]
    },
    {
      "id": "slugify-ascii",
      "category": "text",
      "prompt": "Lowercase ASCII letters and digits; replace runs of all other characters with a single hyphen; strip leading and trailing hyphens.",
      "cases": [
        {
          "input": "Hello, World!",
          "expected": "hello-world"
        },
        {
          "input": " A__B 123 ",
          "expected": "a-b-123"
        },
        {
          "input": "---",
          "expected": ""
        }
      ]
    },
    {
      "id": "flatten-lists",
      "category": "data",
      "prompt": "Recursively flatten nested lists into one list, preserving left-to-right order.",
      "cases": [
        {
          "input": [
            1,
            [
              2,
              [
                3
              ]
            ],
            4
          ],
          "expected": [
            1,
            2,
            3,
            4
          ]
        },
        {
          "input": [],
          "expected": []
        },
        {
          "input": [
            [
              "a"
            ],
            [
              "b",
              "c"
            ]
          ],
          "expected": [
            "a",
            "b",
            "c"
          ]
        }
      ]
    },
    {
      "id": "redact-secret",
      "category": "security",
      "prompt": "Replace every occurrence of the substring 'sk-' followed by consecutive ASCII letters/digits with '[REDACTED]'.",
      "cases": [
        {
          "input": "token sk-ABC123 goes here",
          "expected": "token [REDACTED] goes here"
        },
        {
          "input": "sk-12,sk-ab",
          "expected": "[REDACTED],[REDACTED]"
        },
        {
          "input": "no secrets",
          "expected": "no secrets"
        }
      ]
    },
    {
      "id": "relative-path",
      "category": "security",
      "prompt": "Return true only for a nonempty POSIX relative path with no dot or dot-dot segments and no backslashes.",
      "cases": [
        {
          "input": "src/app.py",
          "expected": true
        },
        {
          "input": "../secrets",
          "expected": false
        },
        {
          "input": "/etc/passwd",
          "expected": false
        },
        {
          "input": "a/./b",
          "expected": false
        }
      ]
    },
    {
      "id": "interval-overlap",
      "category": "logic",
      "prompt": "Given a list of two half-open [start,end] intervals, return whether their intersection is nonempty.",
      "cases": [
        {
          "input": [
            [
              1,
              3
            ],
            [
              3,
              5
            ]
          ],
          "expected": false
        },
        {
          "input": [
            [
              1,
              4
            ],
            [
              3,
              7
            ]
          ],
          "expected": true
        },
        {
          "input": [
            [
              -5,
              0
            ],
            [
              -1,
              2
            ]
          ],
          "expected": true
        }
      ]
    },
    {
      "id": "shallow-merge",
      "category": "data",
      "prompt": "Given two dictionaries in a list, return a shallow merge with second dictionary values taking precedence.",
      "cases": [
        {
          "input": [
            {
              "a": 1
            },
            {
              "b": 2
            }
          ],
          "expected": {
            "a": 1,
            "b": 2
          }
        },
        {
          "input": [
            {
              "a": 1
            },
            {
              "a": 4
            }
          ],
          "expected": {
            "a": 4
          }
        },
        {
          "input": [
            {},
            {}
          ],
          "expected": {}
        }
      ]
    },
    {
      "id": "frequency",
      "category": "data",
      "prompt": "Return a dictionary mapping each string in a list to its number of appearances.",
      "cases": [
        {
          "input": [
            "a",
            "b",
            "a"
          ],
          "expected": {
            "a": 2,
            "b": 1
          }
        },
        {
          "input": [],
          "expected": {}
        },
        {
          "input": [
            "x",
            "x",
            "x"
          ],
          "expected": {
            "x": 3
          }
        }
      ]
    },
    {
      "id": "most-frequent",
      "category": "logic",
      "prompt": "Return the most frequent string from a nonempty list; break ties by lexicographically smallest string.",
      "cases": [
        {
          "input": [
            "b",
            "a",
            "b"
          ],
          "expected": "b"
        },
        {
          "input": [
            "b",
            "a"
          ],
          "expected": "a"
        },
        {
          "input": [
            "z"
          ],
          "expected": "z"
        }
      ]
    },
    {
      "id": "url-query",
      "category": "text",
      "prompt": "Parse a URL query string into a mapping to the final value for each key; decode percent escapes and plus signs.",
      "cases": [
        {
          "input": "a=1&b=two+words",
          "expected": {
            "a": "1",
            "b": "two words"
          }
        },
        {
          "input": "x=%2F&x=2",
          "expected": {
            "x": "2"
          }
        },
        {
          "input": "",
          "expected": {}
        }
      ]
    },
    {
      "id": "semver-newer",
      "category": "logic",
      "prompt": "Given two dotted three-part nonnegative integer version strings, return whether the first is strictly newer.",
      "cases": [
        {
          "input": [
            "1.2.3",
            "1.2.2"
          ],
          "expected": true
        },
        {
          "input": [
            "1.2.0",
            "1.2.0"
          ],
          "expected": false
        },
        {
          "input": [
            "1.10.0",
            "1.9.8"
          ],
          "expected": true
        }
      ]
    },
    {
      "id": "hex-valid",
      "category": "security",
      "prompt": "Return true if a string is a nonempty even-length sequence of ASCII hexadecimal digits.",
      "cases": [
        {
          "input": "aF02",
          "expected": true
        },
        {
          "input": "0",
          "expected": false
        },
        {
          "input": "zzz",
          "expected": false
        },
        {
          "input": "",
          "expected": false
        }
      ]
    },
    {
      "id": "cents-discount",
      "category": "math",
      "prompt": "Given [price_in_cents, percent_discount] return discounted cents using integer floor division, never floats.",
      "cases": [
        {
          "input": [
            1000,
            25
          ],
          "expected": 750
        },
        {
          "input": [
            999,
            10
          ],
          "expected": 899
        },
        {
          "input": [
            100,
            100
          ],
          "expected": 0
        }
      ]
    },
    {
      "id": "cycle-detection",
      "category": "logic",
      "prompt": "Given an adjacency dictionary mapping node strings to dependency lists, return true if the directed graph has any cycle.",
      "cases": [
        {
          "input": {
            "a": [
              "b"
            ],
            "b": [
              "a"
            ]
          },
          "expected": true
        },
        {
          "input": {
            "a": [
              "b"
            ],
            "b": []
          },
          "expected": false
        },
        {
          "input": {
            "x": [
              "x"
            ]
          },
          "expected": true
        }
      ]
    },
    {
      "id": "longest-prefix",
      "category": "text",
      "prompt": "Return the longest common prefix of all strings in the list; for an empty list return an empty string.",
      "cases": [
        {
          "input": [
            "flower",
            "flow",
            "flight"
          ],
          "expected": "fl"
        },
        {
          "input": [
            "abc",
            "abc"
          ],
          "expected": "abc"
        },
        {
          "input": [],
          "expected": ""
        }
      ]
    }
  ]
}
